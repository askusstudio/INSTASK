# ==============================================================================
# INSTASK - Production Environment Variables Template (.env.production)
# ==============================================================================

# App URLs
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Stripe LIVE Credentials (from Stripe Dashboard -> Developers -> API Keys)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_MONTHLY_PRICE_ID="price_1Q..."
STRIPE_50_OFF_COUPON_ID="FIRST50"

# Meta App Authentication (Meta Developer App -> Settings)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

# Database (Supabase / Managed PostgreSQL)
DATABASE_URL="postgresql://postgres:password@db.project.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.project.supabase.co:5432/postgres"

# AI & Scraper APIs
GEMINI_API_KEY="your_gemini_api_key"
APIFY_API_TOKEN="your_apify_api_token"
CREATOMATE_API_KEY="your_creatomate_api_key"
