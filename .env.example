# ==============================================================================
# INSTASK - Environment Configuration Template
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. Database & ORM (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string with connection pooling (e.g. pgBouncer on port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Google Gemini AI (Strategy & Copy Engine)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# INSTASK uses the high-performance 'gemini-2.5-flash' model with JSON mode.
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 3. Apify (Competitor Instagram Intelligence Ingestion)
# ------------------------------------------------------------------------------
# Apify token for Instagram Scraper Actor (https://apify.com/apify/instagram-scraper)
APIFY_API_TOKEN="your_apify_api_token_here"

# ------------------------------------------------------------------------------
# 4. Creatomate (Dynamic Visual Template Image Rendering)
# ------------------------------------------------------------------------------
# Get your API key from Creatomate (https://creatomate.com)
CREATOMATE_API_KEY="your_creatomate_api_key_here"
# Pre-designed Creatomate Template IDs (1:1 Square: 1080x1080 & 4:5 Portrait: 1080x1350)
CREATOMATE_TEMPLATE_ID_1_1="template-instask-square-01"
CREATOMATE_TEMPLATE_ID_4_5="template-instask-portrait-01"

# ------------------------------------------------------------------------------
# 5. Meta Instagram Graph API (v21.0 Auto-Publisher)
# ------------------------------------------------------------------------------
# Meta Developer App Settings (https://developers.facebook.com/)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_REDIRECT_URI="http://localhost:3000/api/meta/auth"

# Connected Instagram Professional Account Credentials
# (Can be auto-populated via the 1-Click Connect flow)
META_ACCESS_TOKEN="your_long_lived_60_day_access_token"
META_IG_USER_ID="your_instagram_business_account_id"

# ------------------------------------------------------------------------------
# 6. Task Queue & Cron Scheduler (Upstash QStash)
# ------------------------------------------------------------------------------
# QStash for persistent 15-minute cron triggers (https://console.upstash.com/qstash)
QSTASH_TOKEN="your_qstash_token"
QSTASH_CURRENT_SIGNING_KEY="your_qstash_current_signing_key"
QSTASH_NEXT_SIGNING_KEY="your_qstash_next_signing_key"

# Secret token to protect the cron endpoint (/api/cron/publish)
# Supply via header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="instask_secure_cron_secret_key_change_in_production"

# ------------------------------------------------------------------------------
# 7. NextAuth.js (Multi-Channel Session Authentication)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="instask_super_secret_jwt_key_2026"

# ------------------------------------------------------------------------------
# 8. Stripe Payments & Dynamic Discount Subscriptions
# ------------------------------------------------------------------------------
# Stripe API secret key from Stripe Dashboard (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# Stripe webhook signing secret from Stripe Dashboard Webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."
# Base Monthly Price ID for the Pro Growth Plan ($49/mo)
STRIPE_MONTHLY_PRICE_ID="price_pro_growth_monthly_49"
# 50% Off First Month Stripe Coupon ID
STRIPE_50_OFF_COUPON_ID="FIRST50"
